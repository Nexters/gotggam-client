# 외부 API 서버의 origin (필수). `/api/v1` 경로는 http-client 가 붙이므로 넣지 않는다.
# 브라우저 번들에 인라인되므로 비밀 값을 넣지 않는다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# OpenAPI 스펙 주소 (`pnpm generate:api` 전용, 선택)
# 미설정 시 `${NEXT_PUBLIC_API_BASE_URL}/v3/api-docs` 를 사용한다.
# API_SPEC_URL=https://dev-api.gotggam.com/v3/api-docs

# 노션 약관 DB (필수, 서버 전용 — NEXT_PUBLIC_ 접두사를 붙이지 않는다)
# 토큰: notion.so/my-integrations 의 internal integration 시크릿
# data source ID: GET /v1/databases/{database_id} 응답의 data_sources[].id
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_TERMS_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
